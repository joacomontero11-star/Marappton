{
  "expo": {
    "name": "MarApptón del Allende",
    "slug": "maraton-app-allende",
    "scheme": "allendeapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A9FDB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ar.com.allende.maratonapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ar.com.allende.maratonapp",
      "adaptiveIcon": {
        "backgroundColor": "#1A9FDB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación solo mientras registrás una corrida, para calcular distancia, tiempo, ritmo y dibujar tu recorrido.",
          "locationAlwaysAndWhenInUsePermission": "Si lo permitís, seguimos registrando tu corrida con la pantalla apagada. Solo durante una corrida.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": ""
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ead2602a-6167-4f65-9cb6-bef5a58bc6a5"
      }
    },
    "owner": "joacomontero11"
  }
}
